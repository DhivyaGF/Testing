import base64
import re
import time
from pathlib import Path
from urllib.parse import urlparse

from selenium import webdriver
from selenium.webdriver.edge.options import Options
from selenium.webdriver.support.ui import WebDriverWait


# Folder in which the generated PDF files will be saved
OUTPUT_FOLDER = Path("pdf_output")
OUTPUT_FOLDER.mkdir(exist_ok=True)


def normalize_url(url):
    """
    Adds https:// when the user enters a URL without a protocol.
    """

    url = url.strip()

    if not url.startswith(("http://", "https://")):
        url = "https://" + url

    return url


def create_safe_filename(url, index):
    """
    Creates a valid PDF filename from the URL.
    """

    parsed_url = urlparse(url)

    name = parsed_url.netloc + parsed_url.path

    name = name.strip("/")
    name = re.sub(r"[^\w\-]+", "_", name)
    name = name.strip("_")

    if not name:
        name = f"webpage_{index}"

    # Prevent excessively long filenames
    name = name[:120]

    return f"{index:02d}_{name}.pdf"


def auto_scroll_page(driver):
    """
    Scrolls through the webpage to load lazy-loaded content and images.
    """

    previous_height = 0

    for _ in range(30):
        current_height = driver.execute_script(
            "return document.body.scrollHeight"
        )

        driver.execute_script(
            "window.scrollTo(0, document.body.scrollHeight);"
        )

        time.sleep(1)

        new_height = driver.execute_script(
            "return document.body.scrollHeight"
        )

        if new_height == previous_height:
            break

        previous_height = current_height

    # Return to the top before printing
    driver.execute_script("window.scrollTo(0, 0);")
    time.sleep(1)


def save_page_as_pdf(driver, url, output_file):
    """
    Opens a webpage in Edge and saves it as a PDF file.
    """

    print(f"\nOpening: {url}")

    driver.get(url)

    # Wait for the page document to finish loading
    WebDriverWait(driver, 60).until(
        lambda browser: browser.execute_script(
            "return document.readyState"
        ) == "complete"
    )

    # Give dynamic content some additional time
    time.sleep(2)

    # Load lazy-loaded page content
    auto_scroll_page(driver)

    # Use screen styling where possible
    driver.execute_cdp_cmd(
        "Emulation.setEmulatedMedia",
        {
            "media": "screen"
        }
    )

    pdf_result = driver.execute_cdp_cmd(
        "Page.printToPDF",
        {
            "printBackground": True,
            "preferCSSPageSize": False,

            # A4 dimensions in inches
            "paperWidth": 8.27,
            "paperHeight": 11.69,

            "marginTop": 0.39,
            "marginBottom": 0.39,
            "marginLeft": 0.39,
            "marginRight": 0.39,

            "landscape": False,
            "displayHeaderFooter": False,
            "scale": 0.9
        }
    )

    pdf_data = base64.b64decode(pdf_result["data"])

    with open(output_file, "wb") as pdf:
        pdf.write(pdf_data)

    print(f"Saved: {output_file.resolve()}")


def collect_urls():
    """
    Asks the user to enter multiple URLs.

    Enter one URL per line.
    Press Enter without typing anything to finish.
    """

    urls = []

    print("Enter one URL at a time.")
    print("Press Enter on an empty line when finished.\n")

    while True:

        url = input(f"URL {len(urls) + 1}: ").strip()

        if not url:
            break

        urls.append(normalize_url(url))

    return urls


def convert_urls_to_pdf():
    """
    Main function that converts all entered URLs into PDF files.
    """

    urls = collect_urls()

    if not urls:
        print("No URLs were entered.")
        return

    edge_options = Options()

    # Headless mode means Edge runs without opening a visible window
    edge_options.add_argument("--headless=new")
    edge_options.add_argument("--disable-gpu")
    edge_options.add_argument("--no-sandbox")
    edge_options.add_argument("--disable-dev-shm-usage")
    edge_options.add_argument("--window-size=1920,1080")

    driver = None
    successful = 0
    failed = 0

    try:
        # Selenium Manager automatically locates or obtains
        # the appropriate Edge WebDriver
        driver = webdriver.Edge(options=edge_options)

        for index, url in enumerate(urls, start=1):

            filename = create_safe_filename(url, index)
            output_file = OUTPUT_FOLDER / filename

            try:
                save_page_as_pdf(
                    driver=driver,
                    url=url,
                    output_file=output_file
                )

                successful += 1

            except Exception as error:
                failed += 1

                print(f"Failed to convert: {url}")
                print(f"Reason: {error}")

    except Exception as error:
        print("\nMicrosoft Edge could not be started.")
        print(f"Reason: {error}")
        print("\nCheck that:")
        print("1. Microsoft Edge is installed.")
        print("2. Selenium is updated.")
        print("3. The VS Code Jupyter kernel was restarted.")

    finally:
        if driver is not None:
            driver.quit()

    print("\nConversion completed.")
    print(f"Successful: {successful}")
    print(f"Failed: {failed}")
    print(f"Output folder: {OUTPUT_FOLDER.resolve()}")


# Run the converter in Jupyter Notebook
convert_urls_to_pdf()